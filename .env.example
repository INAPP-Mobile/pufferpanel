# PufferPanel Environment Configuration
# Copy to .env for local (non-Railway) testing. Railway injects most of these
# automatically — only set what you need to override.

# --- Admin bootstrap (first boot only, when database.db doesn't exist) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# Min 8 chars. On Railway, leave unset in the deploy form to get ${{secret(16)}}.
ADMIN_PASSWORD=change-me-please

# --- Panel behaviour ---
# Allow public self-registration (false = admin creates accounts)
PUFFER_PANEL_REGISTRATIONENABLED=false

# --- Railway-injected (do not set locally) ---
# PORT=8080
# RAILWAY_PUBLIC_DOMAIN=your-app.up.railway.app